# QMTech XC7K325T dev board -- standalone DDR3 test (qmtech_ddr3.v)
# DDR3 section generated from LiteX's qmtech_kintex7_devboard platform
# (same LOCs as openXC7/demo-projects litex-ddr-qmtech-kintex7).
set_property LOC F22 [get_ports clk50]
set_property IOSTANDARD LVCMOS33 [get_ports clk50]
create_clock -period 20.000 -name clk50 [get_ports clk50]
set_property LOC U26 [get_ports sw2_n]
set_property IOSTANDARD LVCMOS33 [get_ports sw2_n]
set_property LOC AE22 [get_ports tx]
set_property IOSTANDARD LVCMOS33 [get_ports tx]
set_property LOC AF22 [get_ports rx]
set_property IOSTANDARD LVCMOS33 [get_ports rx]
set_property LOC R26 [get_ports {led_n[0]}]
set_property LOC P26 [get_ports {led_n[1]}]
set_property LOC N26 [get_ports {led_n[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_n[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_n[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_n[2]}]

# ---- DDR3 (bank 34, SSTL15) ----
