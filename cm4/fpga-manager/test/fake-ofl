#!/bin/bash
# fake openFPGALoader for off-board tests
echo "$(date +%T) $*" >> "$MOCK_DIR/ofl.log"
if [[ " $* " == *" --read-xadc "* ]]; then echo "{\"temp\": ${MOCK_TEMP:-$(cat "$MOCK_DIR/temp" 2>/dev/null || echo 40.5)}, \"vccint\": 1.0, \"vccaux\": 1.8, }"; exit 0; fi
if [[ " $* " == *" --detect "* ]]; then printf 'index 0:\n\tidcode 0x3651093\n\tmanufacturer xilinx\n\tfamily kintex7\n\tmodel  xc7k325t\n\tirlength 6\n'; exit 0; fi
if [[ " $* " == *" --read-register "* ]]; then echo "Register raw value: 0x401079fc"; exit 0; fi
bit="${@: -1}"
sleep "${MOCK_FLASH_S:-1}"
if [ -f "$MOCK_DIR/fail-$(basename "$bit" .bit)" ]; then echo "Error: something"; exit 1; fi
echo "Jtag frequency : requested 6000000 Hz -> real 6000000 Hz"
for i in $(seq 0 1 100); do printf '\rLoad SRAM: [%-50s] %d.00%%' "$(printf '=%.0s' $(seq 1 $((i/2+1))))" $i; done; echo
echo "Done"; echo "done 1"
# what the "FPGA" now runs: write a line to the fake CM4 UART if it's pvt-lab
basename "$bit" .bit > "$MOCK_DIR/loaded"
